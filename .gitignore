# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...and .env.example is that opt-in. It holds no secrets, only the list of
# variables the app reads. Without this negation the `.env*` line above hides
# it from every clone, so a self-hoster gets no starting point at all (#46).
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local waitlist sink (dev only)
.waitlist.jsonl
