{
  "name": "endpointforms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/db-migrate.mts",
    "db:migrate:neon": "DB_TARGET=neon npm run db:migrate",
    "db:create-app-role:neon": "DB_TARGET=neon node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/db-create-app-role.mts",
    "db:seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/db-seed.mts",
    "db:seed:neon": "DB_TARGET=neon npm run db:seed",
    "db:studio": "drizzle-kit studio",
    "db:studio:neon": "DB_TARGET=neon drizzle-kit studio",
    "db:reset": "docker compose down -v && npm run db:up && npm run db:migrate && npm run db:seed",
    "lint": "eslint",
    "roadmap": "bash scripts/sync-roadmap.sh",
    "test": "node --experimental-strip-types tests/waitlist-validate.test.mjs && node --experimental-strip-types tests/tools.test.mjs && node --experimental-strip-types tests/content-links.test.mjs && node --experimental-strip-types tests/tools-ungated.test.mjs && node --experimental-strip-types tests/workspace-slug.test.mjs && npm run test:origin && npm run test:schema && npm run test:render && npm run test:db",
    "test:origin": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types tests/origin.test.mts",
    "test:db": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types tests/tenant-isolation.test.mts && npm run test:access && npm run test:ingest && npm run test:schema:db && npm run test:auth",
    "test:access": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types tests/workspace-access.test.mts",
    "test:ingest": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types tests/ingest.test.mts",
    "test:schema": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types tests/form-schema.test.mts",
    "test:render": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types tests/form-render.test.mts",
    "test:schema:db": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types tests/schema-ingest.test.mts",
    "test:auth": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types tests/auth-password.test.mts",
    "test:db:neon": "DB_TARGET=neon npm run test:db",
    "verify": "bash scripts/verify.sh"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@base-ui/react": "^1.7.0",
    "@node-rs/argon2": "^2.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.35.0",
    "nanoid": "^6.0.1",
    "next": "16.3.3",
    "next-auth": "^5.0.0-beta.32",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "uuidv7": "^1.2.1",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "server-only": "^0.0.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
